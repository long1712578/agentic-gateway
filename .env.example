# Generate each value independently with at least 32 random bytes.
AGENTIC_GATEWAY_API_KEY=
AGENTIC_GATEWAY_MCP_API_KEY=
# Optional. If blank, the gateway creates a separate admin key in its data volume.
AGENTIC_GATEWAY_ADMIN_KEY=

# Leave these blank when configuring the upstream through /admin.
# Set them together only when the environment manages the upstream.
AGENTIC_GATEWAY_OPENAI_BASE_URL=
AGENTIC_GATEWAY_OPENAI_API_KEY=
AGENTIC_GATEWAY_DEFAULT_UPSTREAM_MODEL=
