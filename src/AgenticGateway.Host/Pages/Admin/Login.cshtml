@page "/admin/login"
@model AgenticGateway.Host.Pages.Admin.LoginModel
@{
    Layout = null;
}
<!doctype html>
<html lang="vi">
<head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>Đăng nhập · Agentic Gateway</title><link rel="stylesheet" href="/admin/assets/admin.css" /></head>
<body class="login-body">
    <main class="login-card">
        <div class="brand login-brand"><span class="brand-mark">◇</span><span><strong>Agentic Gateway</strong><small>Local control room</small></span></div>
        <p class="eyebrow">QUẢN TRỊ LOCAL</p>
        <h1>Chào mừng trở lại</h1>
        <p class="muted">Nhập key quản trị để mở bảng điều khiển.</p>
        @if (Model.Error is not null) { <div class="notice error" role="alert">@Model.Error</div> }
        <form method="post" class="stack">
            <label for="Key">Admin key</label>
            <input id="Key" asp-for="Key" type="password" autocomplete="off" required autofocus />
            <button class="button button-primary" type="submit">Đăng nhập</button>
        </form>
        <p class="fine-print">Nguồn key: <code>@Model.KeyLocation</code>.</p>
    </main>
</body>
</html>
