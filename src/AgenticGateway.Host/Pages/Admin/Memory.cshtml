@page "/admin/memory"
@model AgenticGateway.Host.Pages.Admin.MemoryModel
@{
    ViewData["Title"] = "Shared Memory";
}
<div class="page-intro"><div><p class="eyebrow">03 / PROJECT KNOWLEDGE</p><h2>Kiến thức chung của các agent</h2><p>Cùng projectId giúp Codex, Claude Code, Kiro và Copilot tìm lại quyết định và handoff của nhau.</p></div><span class="pill">MCP · SQLite</span></div>
@if (Model.Notice is not null) { <div class="notice success" role="status">@Model.Notice</div> }
@if (Model.Error is not null) { <div class="notice error" role="alert">@Model.Error</div> }
<section class="panel"><div class="panel-heading"><div><p class="eyebrow">RECALL</p><h2>Tìm memory theo project</h2></div></div><form method="get" class="search-form"><div class="form-field"><label for="projectId">Project ID</label><input id="projectId" name="projectId" value="@Model.ProjectId" maxlength="120" required /></div><div class="form-field grow"><label for="query">Tìm quyết định, bài học hoặc handoff</label><input id="query" name="query" value="@Model.Query" maxlength="512" placeholder="Ví dụ: model nào dùng cho Codex?" required /></div><button class="button button-primary" type="submit">Tìm</button></form>
@if (!string.IsNullOrWhiteSpace(Model.Query)) {
    @if (Model.Results.Count == 0) { <div class="empty-state">Chưa tìm thấy memory phù hợp. Hãy thử từ khóa khác hoặc lưu ghi chú mới.</div> }
    else { <div class="memory-results">@foreach (var result in Model.Results) { <article class="memory-result"><div class="result-meta"><span class="tag neutral">@result.Entry.Kind</span><span>@result.Entry.SourceAgent · @result.Entry.CreatedAt.ToLocalTime().ToString("g")</span></div><p>@result.Entry.Content</p>@if (!string.IsNullOrWhiteSpace(result.Entry.SourceReference)) { <small>Nguồn: @result.Entry.SourceReference</small> }@if (result.ContentTruncated) { <small>Nội dung đã được rút gọn.</small> }</article> }</div> }
}
</section>
<div class="two-column">
    <section class="panel"><div class="panel-heading"><div><p class="eyebrow">REMEMBER</p><h2>Ghi kiến thức bền vững</h2></div></div><form method="post" asp-page-handler="Remember" class="stack form-stack"><input type="hidden" asp-for="ProjectId" /><div class="form-field"><label asp-for="Kind">Loại ghi chú</label><select asp-for="Kind"><option>Decision</option><option>Fact</option><option>Lesson</option><option>Preference</option><option>Handoff</option><option>Observation</option></select></div><div class="form-field"><label asp-for="MemoryContent">Nội dung</label><textarea asp-for="MemoryContent" rows="5" maxlength="32000" placeholder="Một thông tin ngắn, dùng lại được" required></textarea></div><div class="form-field"><label asp-for="SourceReference">Nguồn tham chiếu (tùy chọn)</label><input asp-for="SourceReference" maxlength="1024" placeholder="File, tài liệu hoặc commit" /></div><p class="fine-print">Memory là ghi chú có nguồn, không phải instruction hệ thống. Tránh lưu key, prompt đầy đủ hoặc dữ liệu riêng tư.</p><button class="button button-primary" type="submit">Lưu vào @Model.ProjectId</button></form></section>
    <aside class="panel guidance"><p class="eyebrow">DREAMING</p><h2>Gộp kiến thức khi cần</h2><p>Gateway chọn tối đa 20 memory chưa tổng hợp và gửi chúng tới model đã cấu hình để tạo summary có tham chiếu nguồn.</p><form method="post" asp-page-handler="Dream" class="stack"><input type="hidden" asp-for="ProjectId" /><label class="checkbox-line"><input asp-for="Confirmed" type="checkbox" required /> Tôi đồng ý gửi memory của project này tới upstream; thao tác có thể phát sinh chi phí.</label><button class="button button-secondary" type="submit">Chạy memory_dream</button></form><p class="fine-print">Dreaming hiện chạy theo lệnh; chưa có lịch nền hoặc tự thu thập transcript.</p></aside>
</div>
